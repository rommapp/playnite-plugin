<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="UDM" value="https://gitlab.com/api/v4/projects/85661048/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- UDM publishes its API to this public feed, also used by Legendary. -->
    <packageSource key="UDM">
      <package pattern="UnifiedDownloadManagerApi" />
    </packageSource>
  </packageSourceMapping>
</configuration>
